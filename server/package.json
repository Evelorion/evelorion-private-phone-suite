{
  "name": "contacts-e2ee-sync-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Zero-knowledge sync server for the private Contacts / Phone Android apps",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "node --watch --experimental-strip-types src/index.ts",
    "test:e2e": "node --experimental-strip-types test/e2e.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin.ts",
    "test:web": "node test/webcheck.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "10.1.2",
    "@simplewebauthn/server": "^13.1.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "hash-wasm": "^4.12.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "typescript": "^5.7.3"
  }
}
