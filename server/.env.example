# 监听地址。放在 nginx/caddy 反代后面时用 127.0.0.1
HOST=0.0.0.0
PORT=8443

# 对外访问地址，不能带末尾斜杠。WebAuthn/通行密钥会校验此 Origin。
PUBLIC_ORIGIN=https://contacts.example.com:443

# SQLite 数据库路径
DB_PATH=./data/sync.db

# 用于签发访问令牌的服务端密钥。必须是 64 位十六进制（32 字节）。
# 生成：openssl rand -hex 32
# 换掉这个值会让所有设备的令牌失效（需要重新登录，但数据不受影响）。
SERVER_SECRET=CHANGE_ME_openssl_rand_hex_32

# 注册邀请码。自建服务器强烈建议设置，否则任何人都能在你的服务器上开账号。
# 留空 = 允许任意注册（只建议在内网/测试时这样）。
REGISTRATION_TOKEN=CHANGE_ME_generate_a_random_invite

# 访问令牌有效期（秒），刷新令牌有效期（天）
ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=60

# 单条联系人密文上限（字节）与头像 blob 上限（字节）
MAX_RECORD_BYTES=65536
MAX_BLOB_BYTES=4194304

# 墓碑保留天数，超过后服务端物理删除
TOMBSTONE_TTL_DAYS=90

# 信任反代传来的 X-Forwarded-For（放在 nginx/caddy 后面时设为 true）
TRUST_PROXY=true
