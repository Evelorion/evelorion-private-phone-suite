<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      debug 包通常使用临时调试证书，不能和已安装的正式 Contacts 包重复声明
      signature 权限，否则 Android 会以 INSTALL_FAILED_DUPLICATE_PERMISSION 拒绝安装。
      调试包仍然可以测试 Telecom；它不会获得正式 Contacts 的私密数据权限。
    -->
    <permission
        android:name="com.evelorion.permission.READ_PRIVATE_CONTACTS"
        tools:node="remove" />
    <permission
        android:name="com.evelorion.permission.VAULT_BRIDGE"
        tools:node="remove" />

</manifest>
