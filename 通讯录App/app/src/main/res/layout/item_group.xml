<?xml version="1.0" encoding="utf-8"?>
<!-- 严格对应设计稿的尺寸，出处见 dimens.xml 里各条的注释。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="66dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="@dimen/group_row_padding_vertical"
    android:paddingEnd="8dp"
    android:paddingBottom="@dimen/group_row_padding_vertical">

    <FrameLayout
        android:layout_width="@dimen/group_icon_size"
        android:layout_height="@dimen/group_icon_size"
        android:background="@drawable/bg_icon_tile">

        <ImageView
            android:id="@+id/group_icon"
            android:layout_width="21dp"
            android:layout_height="21dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_group"
            app:tint="?attr/colorOnTertiaryContainer" />
    </FrameLayout>

    <TextView
        android:id="@+id/group_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Text.BodyLarge"
        tools:text="家人" />

    <TextView
        android:id="@+id/group_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:textAppearance="@style/Text.BodySmall"
        tools:text="4" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        app:tint="?attr/colorOnSurfaceVariant" />

</LinearLayout>
