<?xml version="1.0" encoding="utf-8"?>
<!-- 扩展 FAB。规范型用 primary_container 配 on_primary_container，
     不是实心主色 —— 设计稿里 fabBg 取的是 primary container 那个变量。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorOnPrimaryContainer">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/fab_radius" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/fab_radius" />
            <solid android:color="?attr/colorPrimaryContainer" />
        </shape>
    </item>
</ripple>
