<?xml version="1.0" encoding="utf-8"?>
<!-- 群组标签、搜索历史词。透明 + 描边。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="?attr/colorOnSurfaceVariant">
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tag_radius" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tag_radius" />
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1dp" android:color="?attr/colorOutlineVariant" />
        </shape>
    </item>
</ripple>
