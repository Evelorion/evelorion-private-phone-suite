<?xml version="1.0" encoding="utf-8"?>
<!-- 一种加密模式。选中时描边换主色，未选中是普通卡片。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mode_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_mode_card"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/mode_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="@style/Text.BodyLarge"
            android:textStyle="bold"
            tools:text="Keystore 保管" />

        <ImageView
            android:id="@+id/mode_check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_star_filled"
            android:visibility="invisible"
            app:tint="?attr/colorPrimary"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/mode_desc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:textAppearance="@style/Text.BodySmall"
        tools:text="口令由 Android Keystore 保管，开机即可用。" />

</LinearLayout>
