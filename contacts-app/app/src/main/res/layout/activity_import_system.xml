<?xml version="1.0" encoding="utf-8"?>
<!--
  从系统通讯录导入。

  两步，分开做：
    1. 导入 —— 把联系人复制进加密库，**不动系统里的原件**
    2. 确认结果没问题之后，可选地删掉系统里的原件

  为什么不合成一步：删除不可逆，一次可能上千条。用户得先看到
  「导入了多少、跳过了多少」，才有依据决定要不要删。
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_spacer">

        <ImageView
            android:id="@+id/back"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_ripple"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="@string/import_title"
            android:textAppearance="@style/Text.TitleLarge" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingStart="@dimen/card_margin_horizontal"
        android:paddingTop="8dp"
        android:paddingEnd="@dimen/card_margin_horizontal"
        android:paddingBottom="32dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/import_intro"
                android:textAppearance="@style/Text.BodySmall"
                android:textSize="14sp" />

            <!-- ═══ 第一步：导入 ═══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_step1"
                    android:textAppearance="@style/Text.SectionHeader" />

                <TextView
                    android:id="@+id/available"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAppearance="@style/Text.BodyLarge"
                    tools:text="系统通讯录里有 23 位联系人" />

                <TextView
                    android:id="@+id/import_result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="@style/Text.BodySmall"
                    android:visibility="gone"
                    tools:text="已导入 20 位，跳过重复 3 位"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/import_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/filled_button_height"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_filled_button"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/import_action"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="16sp" />
            </LinearLayout>

            <!-- ═══ 第二步：删除原件（导入成功后才出现）═══ -->
            <LinearLayout
                android:id="@+id/cleanup_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_step2"
                    android:textAppearance="@style/Text.SectionHeader" />

                <TextView
                    android:id="@+id/cleanup_desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/import_step2_desc"
                    android:textAppearance="@style/Text.BodySmall" />

                <TextView
                    android:id="@+id/cleanup_button"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/filled_button_height"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_tag"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="@string/import_cleanup_action"
                    android:textColor="?attr/colorError"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:lineSpacingExtra="4dp"
                android:text="@string/import_caveat"
                android:textAppearance="@style/Text.BodySmall"
                android:textSize="13sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
