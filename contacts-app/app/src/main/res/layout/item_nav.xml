<?xml version="1.0" encoding="utf-8"?>
<!-- 严格对应设计稿的尺寸，出处见 dimens.xml 里各条的注释。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:background="?android:attr/selectableItemBackgroundBorderless"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <FrameLayout
        android:id="@+id/pill"
        android:layout_width="@dimen/nav_pill_width"
        android:layout_height="@dimen/nav_pill_height"
        android:background="@drawable/bg_nav_pill">

        <ImageView
            android:id="@+id/icon"
            android:layout_width="@dimen/nav_icon_size"
            android:layout_height="@dimen/nav_icon_size"
            android:layout_gravity="center"
            android:importantForAccessibility="no" />
    </FrameLayout>

    <TextView
        android:id="@+id/label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/nav_label_margin_top"
        android:maxLines="1"
        android:textAppearance="@style/Text.LabelSmall" />

</LinearLayout>
