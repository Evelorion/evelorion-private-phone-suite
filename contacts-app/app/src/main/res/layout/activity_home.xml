<?xml version="1.0" encoding="utf-8"?>
<!--
  主页 · 严格照设计稿 1a「规范型」

  对应设计稿里的这段结构：
      header  padding:8px 16px 4px
        ├ 标题   font-size:32px line-height:40px
        ├ 副标题 font-size:13px color:on_surface_variant margin-top:2px
        └ 「我」 40×40 圆形 tertiary_container，右上，margin-top:6px
      搜索栏  margin-top:14px height:56px radius:28px bg:surface_container_high
              padding:0 20px gap:14px
      列表    padding:0 0 8px，字母分组头吸顶
      FAB     right:18px bottom:18px height:60px radius:20px padding:0 22px
              bg:primary_container  gap:12px  图标 26px  文字 15px
      导航    height:80px bg:surface_container_low 无圆角无阴影
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- 状态栏高度的占位。edge-to-edge 下内容会延伸到状态栏底下，
         用这个 View 把顶部内容顶下来，而不是给根布局加 padding
         （加 padding 的话底部导航也会跟着缩进）。 -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- ══════════════ 顶部 ══════════════ -->

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_padding_horizontal"
        android:layout_marginTop="@dimen/header_padding_top"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/tab_contacts"
        android:textAppearance="@style/Text.HeadlineLarge"
        app:layout_constraintEnd_toStartOf="@+id/profile_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_spacer" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/header_padding_horizontal"
        android:layout_marginTop="@dimen/subtitle_margin_top"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Text.BodySmall"
        app:layout_constraintEnd_toStartOf="@+id/profile_avatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        tools:text="16 位 · 已同步" />

    <TextView
        android:id="@+id/profile_avatar"
        android:layout_width="@dimen/profile_avatar_size"
        android:layout_height="@dimen/profile_avatar_size"
        android:layout_marginTop="@dimen/profile_avatar_margin_top"
        android:layout_marginEnd="@dimen/header_padding_horizontal"
        android:background="@drawable/bg_circle_tertiary"
        android:contentDescription="@string/tab_settings"
        android:gravity="center"
        android:text="@string/profile_initial"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:textSize="15sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_spacer" />

    <!-- ══════════════ 停靠搜索栏 ══════════════
         点了进全屏搜索页，本身不接受输入。这是 M3 的 docked search bar 模式 ——
         列表页因此完全不用处理输入法弹起时的布局变化。 -->

    <LinearLayout
        android:id="@+id/search_bar"
        android:layout_width="0dp"
        android:layout_height="@dimen/search_bar_height"
        android:layout_marginStart="@dimen/header_padding_horizontal"
        android:layout_marginTop="@dimen/search_bar_margin_top"
        android:layout_marginEnd="@dimen/header_padding_horizontal"
        android:background="@drawable/bg_search_bar"
        android:clickable="true"
        android:contentDescription="@string/search_hint"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/search_bar_padding_horizontal"
        android:paddingEnd="@dimen/search_bar_padding_horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/subtitle">

        <ImageView
            android:layout_width="@dimen/search_bar_icon_size"
            android:layout_height="@dimen/search_bar_icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_search"
            app:tint="?attr/colorOnSurfaceVariant" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/search_bar_icon_gap"
            android:layout_weight="1"
            android:text="@string/search_hint"
            android:textAppearance="@style/Text.BodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>

    <!-- ══════════════ 内容区 ══════════════
         三个页面（联系人 / 收藏 / 设置入口）共用这一块，
         由底部导航切换。用 RecyclerView 直接换 adapter 而不是 ViewPager ——
         设计稿里三个页面的顶部区域各不相同，ViewPager 的横滑手势
         反而会和列表的滚动打架。 -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/list_bottom_inset"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar" />

    <!-- 空态 -->
    <LinearLayout
        android:id="@+id/empty"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="40dp"
        android:paddingTop="72dp"
        android:paddingEnd="40dp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/search_bar"
        tools:visibility="visible">

        <FrameLayout
            android:layout_width="@dimen/empty_icon_box"
            android:layout_height="@dimen/empty_icon_box"
            android:background="@drawable/bg_squircle">

            <ImageView
                android:layout_width="@dimen/empty_icon_size"
                android:layout_height="@dimen/empty_icon_size"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_person"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/empty_no_contacts"
            android:textAppearance="@style/Text.TitleMedium" />

        <TextView
            android:id="@+id/empty_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/empty_no_contacts_desc"
            android:textAppearance="@style/Text.BodySmall"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- ══════════════ 扩展 FAB ══════════════ -->

    <LinearLayout
        android:id="@+id/fab"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/fab_height"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:background="@drawable/bg_fab"
        android:clickable="true"
        android:contentDescription="@string/action_new_contact"
        android:elevation="6dp"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/fab_padding_horizontal"
        android:paddingEnd="@dimen/fab_padding_horizontal"
        app:layout_constraintBottom_toTopOf="@+id/bottom_nav"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:layout_width="@dimen/fab_icon_size"
            android:layout_height="@dimen/fab_icon_size"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_person_add"
            app:tint="?attr/colorOnPrimaryContainer" />

        <TextView
            android:id="@+id/fab_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fab_icon_gap"
            android:text="@string/action_new"
            android:textColor="?attr/colorOnPrimaryContainer"
            android:textSize="@dimen/fab_text_size" />
    </LinearLayout>

    <!-- ══════════════ 底部导航 ══════════════
         三项由代码填充（BottomNav.kt），不写死在 XML 里。 -->

    <LinearLayout
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurfaceContainerLow"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
