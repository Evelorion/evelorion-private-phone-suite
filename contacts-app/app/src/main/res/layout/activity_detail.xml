<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 顶部操作行：返回 / 收藏 / 更多，48 触摸区 -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/status_bar_spacer">

        <ImageView
            android:id="@+id/back"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_ripple"
            android:contentDescription="@string/action_back"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="?attr/colorOnSurface" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/star"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_ripple"
            android:contentDescription="@string/toggle_favorite"
            android:padding="12dp"
            android:src="@drawable/ic_star"
            app:tint="?attr/colorOnSurfaceVariant" />

        <ImageView
            android:id="@+id/more"
            android:layout_width="@dimen/icon_button_size"
            android:layout_height="@dimen/icon_button_size"
            android:background="@drawable/bg_circle_ripple"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_more_vert"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="28dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/top_bar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 头像 104 方圆 34%，姓名 30/600 上距 16，职位 14 上距 4 -->
            <ImageView
                android:id="@+id/avatar"
                android:layout_width="@dimen/detail_avatar_size"
                android:layout_height="@dimen/detail_avatar_size"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:importantForAccessibility="no"
                android:scaleType="centerCrop" />

            <TextView
                android:id="@+id/name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginTop="@dimen/detail_name_margin_top"
                android:layout_marginEnd="24dp"
                android:gravity="center"
                android:maxLines="2"
                android:textAppearance="@style/Text.HeadlineMedium"
                tools:text="林晚" />

            <TextView
                android:id="@+id/role"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:textAppearance="@style/Text.BodySmall"
                android:textSize="14sp"
                tools:text="产品设计 · 上海" />

            <!-- 快捷动作 -->
            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/detail_actions_margin_top"
                android:layout_marginBottom="24dp"
                android:orientation="horizontal" />

            <!-- 信息卡片由代码填充：每个 section 一张 bg_card -->
            <LinearLayout
                android:id="@+id/cards_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/card_margin_horizontal"
                android:paddingEnd="@dimen/card_margin_horizontal" />

            <!-- 所属群组 -->
            <TextView
                android:id="@+id/groups_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="20dp"
                android:paddingTop="20dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp"
                android:text="@string/detail_groups"
                android:textAppearance="@style/Text.SectionHeader"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <HorizontalScrollView
                android:id="@+id/groups_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/card_margin_horizontal"
                android:paddingEnd="@dimen/card_margin_horizontal"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/groups_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- 编辑按钮：56 高 28 圆角实心主色 -->
            <LinearLayout
                android:id="@+id/edit_button"
                android:layout_width="match_parent"
                android:layout_height="@dimen/filled_button_height"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                android:background="@drawable/bg_filled_button"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_edit"
                    app:tint="?attr/colorOnPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/detail_edit"
                    android:textColor="?attr/colorOnPrimary"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
