<?xml version="1.0" encoding="utf-8"?>
<!-- 严格对应设计稿的尺寸，出处见 dimens.xml 里各条的注释。 -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_row"
    android:clickable="true"
    android:focusable="true"
    android:minHeight="64dp"
    android:paddingStart="@dimen/row_padding_horizontal"
    android:paddingTop="@dimen/row_padding_vertical"
    android:paddingEnd="@dimen/row_padding_horizontal"
    android:paddingBottom="@dimen/row_padding_vertical">

    <ImageView
        android:id="@+id/avatar"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_gap"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Text.BodyLarge"
        app:layout_constraintBottom_toTopOf="@+id/subtitle"
        app:layout_constraintEnd_toStartOf="@+id/star"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"
        tools:text="林晚" />

    <TextView
        android:id="@+id/subtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/row_gap"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/Text.BodySmall"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/star"
        app:layout_constraintStart_toEndOf="@+id/avatar"
        app:layout_constraintTop_toBottomOf="@+id/name"
        tools:text="产品设计 · 138 0013 8000" />

    <ImageView
        android:id="@+id/star"
        android:layout_width="@dimen/row_star_size"
        android:layout_height="@dimen/row_star_size"
        android:contentDescription="@string/toggle_favorite"
        android:src="@drawable/ic_star_filled"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?attr/colorPrimary"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>
